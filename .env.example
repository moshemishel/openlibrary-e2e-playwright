# Copy this file to `.env` and fill in your values.
# `.env` is gitignored; this `.env.example` is committed as a template.

# OpenLibrary login credentials — required for the reading list functions.
OL_USERNAME=your_account@example.com
OL_PASSWORD=your_password

# Optional: select a profile (default | debug | ci). Defaults to "default".
# PROFILE=debug

# Optional: override individual config keys.
# HEADLESS=false
# SLOW_MO=500
